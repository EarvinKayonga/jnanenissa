---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('expo');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">{entry.data.region ?? 'Exposition interactive'}</span>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.summary}</p>
    </div>
  </section>
  <section class="section alt">
    <article class="wrap prose">{entry.data.image && <Image src={entry.data.image} alt={entry.data.imageAlt ?? ''} widths={[400, 700]} sizes="(min-width: 700px) 640px, 90vw" style="width:100%;max-height:420px;object-fit:cover;border-radius:4px;margin-bottom:2rem" />}<Content /></article>
  </section>
  <section class="section">
    <div class="wrap" style="text-align:center">
      <a class="btn ghost" href="/exposition">← Toute l'exposition</a>
    </div>
  </section>
</Base>
