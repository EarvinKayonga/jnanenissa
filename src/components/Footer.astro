---
import { nav, site } from '../data/site';
---
<footer class="zellige">
  <div class="wrap grid cols-3">
    <div>
      <p class="brand">{site.name}</p>
      <p class="ar" dir="rtl">{site.arabic}</p>
      <p>{site.tagline}.</p>
    </div>
    <div>
      <h3>Explorer</h3>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h3>Nous joindre</h3>
      <ul>
        <li>{site.city}</li>
        <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        <li><a href={`https://wa.me/${site.whatsapp.replace('+', '')}`}>WhatsApp</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.instagram}>Instagram</a></li>
      </ul>
    </div>
  </div>
  <p class="copy">© {new Date().getFullYear()} Jnane nissa · Sur réservation uniquement</p>
</footer>
<style>
  footer { color: var(--cream); padding: 4rem 0 1.5rem; }
  h3 { color: var(--cream); font-size: 1.4rem; }
  .brand { font-family: var(--serif); font-size: 2.2rem; margin: 0; }
  .ar { font-size: 1.4rem; margin: 0 0 1rem; text-align: left; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: .4rem; }
  a { text-decoration: none; opacity: .9; }
  a:hover { text-decoration: underline; }
  .copy { text-align: center; margin: 3rem 0 0; font-size: .8rem; opacity: .7; }
</style>
