---
import { nav, site } from '../data/site';
---
<footer>
  <div class="wrap grid cols-3">
    <div>
      <p class="brand">{site.name}</p>
      <p class="ar" dir="rtl">{site.arabic}</p>
      <p>{site.tagline}.</p>
    </div>
    <div>
      <h4>Explorer</h4>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h4>Nous joindre</h4>
      <ul>
        <li>{site.city}</li>
        <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        <li><a href={`https://wa.me/${site.whatsapp.replace('+', '')}`}>WhatsApp</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.instagram}>Instagram</a></li>
      </ul>
    </div>
  </div>
  <p class="copy">© {new Date().getFullYear()} Jnane nissa · Sur réservation uniquement</p>
</footer>
<style>
  footer { background: var(--green); color: var(--cream); padding: 4.5rem 0 1.5rem; font-size: .95rem; font-weight: 300; }
  h4 { font-family: var(--sans); font-weight: 500; font-size: .75rem; letter-spacing: .22em; text-transform: uppercase; color: var(--rose); margin: 0 0 1.2rem; }
  .brand { font-family: var(--serif); font-size: 2.4rem; line-height: 1; margin: 0 0 .3rem; font-weight: 500; }
  .ar { text-align: left; font-family: 'Amiri', var(--serif); font-size: 1.5rem; margin: 0 0 1rem; color: var(--rose); }
  p { max-width: 24em; opacity: .85; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: .6rem; }
  a { text-decoration: none; opacity: .85; transition: .2s; }
  a:hover { opacity: 1; color: var(--rose); }
  .copy { text-align: center; max-width: none; margin: 3.5rem auto 0; padding-top: 1.5rem; border-top: 1px solid rgba(250,247,241,.2); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; opacity: .65; }
</style>
